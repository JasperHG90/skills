<mxfile host="drawio">
  <diagram id="c4-template" name="dynamic">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Dynamic diagram: Customer places an order" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Trebuchet MS;fontSize=26;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="Shows how one order request flows through the Shop system. Orange: owned by the Shop team. Purple: external systems." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Trebuchet MS;fontSize=14;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1000" height="24" as="geometry" />
        </mxCell>
        <mxCell id="person" value="&lt;b&gt;Customer&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Buys products online" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#e6e6e6;strokeColor=#8a8a8a;fontFamily=Trebuchet MS;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="50" height="72" as="geometry" />
        </mxCell>
        <mxCell id="gcp" value="Google Cloud Platform, shop-prod project&lt;br&gt;[Deployment Node]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=6 4;verticalAlign=top;fontFamily=Trebuchet MS;fontSize=14;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="300" y="130" width="820" height="520" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;Order API&lt;/b&gt;&lt;br&gt;[Container: Cloud Run, Python]&lt;br&gt;Validates and stores orders" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dca26c;strokeColor=#b9804b;fontColor=#ffffff;fontFamily=Trebuchet MS;fontSize=16;shadow=1;" vertex="1" parent="gcp">
          <mxGeometry x="80" y="140" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;Order database&lt;/b&gt;&lt;br&gt;[Container: Cloud SQL, PostgreSQL]&lt;br&gt;Stores orders and their status" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#dca26c;strokeColor=#b9804b;fontColor=#ffffff;fontFamily=Trebuchet MS;fontSize=16;shadow=1;" vertex="1" parent="gcp">
          <mxGeometry x="480" y="140" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="pay" value="&lt;b&gt;Payment provider&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;Charges the customer's card" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8e8299;strokeColor=#6f6479;fontColor=#ffffff;fontFamily=Trebuchet MS;fontSize=16;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1260" y="300" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="NOTE: the API writes the order before it charges the card, so a failed payment leaves an order in status PENDING." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4c4;strokeColor=#e3c66b;fontColor=#000000;fontFamily=Trebuchet MS;fontSize=14;spacing=10;" vertex="1" parent="gcp">
          <mxGeometry x="380" y="330" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="PROPOSED: a retry queue between the API and the payment provider." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4c4;strokeColor=#e3c66b;fontColor=#000000;fontFamily=Trebuchet MS;fontSize=14;spacing=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="1250" y="150" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="1: Places an order&lt;br&gt;[HTTPS, JSON&lt;br&gt;Auth: customer session]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=1.5;jumpStyle=arc;jumpSize=12;fontFamily=Trebuchet MS;fontSize=14;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);" edge="1" parent="1" source="person" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="2: Writes the order&lt;br&gt;[SQL over private IP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=1.5;jumpStyle=arc;jumpSize=12;fontFamily=Trebuchet MS;fontSize=14;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);" edge="1" parent="1" source="api" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="3: Charges the card&lt;br&gt;[HTTPS, REST&lt;br&gt;Auth: API key]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=8;strokeWidth=1.5;jumpStyle=arc;jumpSize=12;fontFamily=Trebuchet MS;fontSize=14;labelBackgroundColor=light-dark(#E8E8E88D,#2a2a2a8D);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="pay">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="480" y="600" />
              <mxPoint x="1360" y="600" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="l1" value="" style="endArrow=none;dashed=1;dashPattern=1 4;html=1;strokeColor=#666666;" edge="1" parent="1" source="n1" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="" style="endArrow=none;dashed=1;dashPattern=1 4;html=1;strokeColor=#666666;" edge="1" parent="1" source="n2" target="pay">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
